INCLUDE_GUARD(GLOBAL)

# Compiles every header of HEADER_DIRECTORY alone, so that each includes
# what it uses.
FUNCTION(STEPRAFT_ADD_HEADER_CHECK TARGET HEADER_DIRECTORY INCLUDE_ROOT)
    FILE(GLOB HEADERS CONFIGURE_DEPENDS "${HEADER_DIRECTORY}/*.hpp")
    SET(SOURCES)
    FOREACH(HEADER IN LISTS HEADERS)
        FILE(RELATIVE_PATH RELATIVE_HEADER "${INCLUDE_ROOT}" "${HEADER}")
        STRING(MAKE_C_IDENTIFIER "${RELATIVE_HEADER}" IDENTIFIER)
        SET(HEADER_SOURCE
            "${CMAKE_CURRENT_BINARY_DIR}/header-check/${IDENTIFIER}.cpp")
        FILE(CONFIGURE OUTPUT "${HEADER_SOURCE}" CONTENT [=[#include "@RELATIVE_HEADER@"
]=] @ONLY)
        LIST(APPEND SOURCES "${HEADER_SOURCE}")
    ENDFOREACH()
    ADD_LIBRARY(${TARGET} OBJECT ${SOURCES})
    TARGET_COMPILE_FEATURES(${TARGET} PRIVATE cxx_std_20)
    TARGET_INCLUDE_DIRECTORIES(${TARGET} PRIVATE "${INCLUDE_ROOT}")
    TARGET_LINK_LIBRARIES(${TARGET} PRIVATE stepraft-warnings)
ENDFUNCTION()
